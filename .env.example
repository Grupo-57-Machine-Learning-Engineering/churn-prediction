# Copie para .env e preencha. O .env NÃO é versionado (ver .gitignore).

# --- MLflow no DagsHub -------------------------------------------------------
# Repositório DagsHub do grupo (abas "Experiments"/"Files" no DagsHub):
# https://dagshub.com/ThiagoZulian/Grupo-57-Machine-Learning-Engineering
# Nota: o nome do repo no DagsHub é diferente do nome no GitHub (churn-prediction).
#
# Duas formas de autenticar — ver README (secao "Tracking de experimentos"):
#
# Opcao A — token: preencha os 3 campos abaixo (URI + usuario + token).
# MLFLOW_TRACKING_URI=https://dagshub.com/ThiagoZulian/Grupo-57-Machine-Learning-Engineering.mlflow
MLFLOW_TRACKING_URI=
# Usuário do DagsHub
MLFLOW_TRACKING_USERNAME=
# Token de acesso do DagsHub (Settings > Tokens). NUNCA commite este valor.
MLFLOW_TRACKING_PASSWORD=
#
# Opcao B — login interativo (dagshub.init): deixe os 3 campos acima em
# branco. O treino entao chama dagshub.init(), que abre o navegador para
# autenticar na primeira vez e cacheia o token localmente depois.
# Repositório usado pelo dagshub.init() (só relevante para a opção B):
DAGSHUB_REPO_OWNER=ThiagoZulian
DAGSHUB_REPO_NAME=Grupo-57-Machine-Learning-Engineering

# Nome do experimento (opcional; default: churn-prediction)
MLFLOW_EXPERIMENT_NAME=churn-prediction
